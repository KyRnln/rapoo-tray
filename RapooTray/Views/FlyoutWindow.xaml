<Window
    x:Class="RapooTray.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RapooTray.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="外设状态">

    <Grid Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Name="SlideUpStoryboard">
                <DoubleAnimation Storyboard.TargetName="WindowTranslateTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="26" To="0"
                                 Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.0" To="1.0"
                                 Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!-- Main Card Container: Transparent to let the pure Mica backdrop shine through -->
        <Border x:Name="RootBorder"
                Margin="1"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="WindowTranslateTransform" Y="0" />
            </Border.RenderTransform>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header (Transparent on top of Mica) -->
                <Grid Grid.Row="0" Padding="14,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE962;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="已连接外设" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="OnRefreshClicked"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" ToolTipService.ToolTip="刷新设备状态">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </Grid>

                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" />

                <!-- Devices List (Floating cards with solid fill on top of Mica) -->
                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DeviceListPanel" Padding="10,8" Spacing="8">
                        <!-- Populated dynamically with individual cards -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Bar (Transparent on top of Mica with subtle top border) -->
                <Grid Grid.Row="2"
                      Background="Transparent"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Rapoo Tray" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />

                    <Button Grid.Column="1" Click="OnOpenSettingsClicked"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                            <TextBlock Text="设置" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
