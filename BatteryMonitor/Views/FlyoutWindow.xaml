<Window
    x:Class="BatteryMonitor.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BatteryMonitor.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="外设状态">

    <Grid Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Name="SlideUpStoryboard">
                <DoubleAnimation Storyboard.TargetName="WindowTranslateTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="18" To="0"
                                 Duration="0:0:0.20">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.0" To="1.0"
                                 Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <!-- Main Card Container: Windows 11 Rounded with subtle dark/gray accent border -->
        <Border x:Name="RootBorder"
                Margin="1"
                Background="Transparent"
                BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="WindowTranslateTransform" Y="0" />
            </Border.RenderTransform>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header: Transparent, text only (no icon, no top border artifact) -->
                <Grid Grid.Row="0" Padding="14,12,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="已连接外设" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />

                    <Button Grid.Column="1" Click="OnRefreshClicked"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" ToolTipService.ToolTip="刷新设备状态">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Devices List (Floating solid cards on translucent acrylic canvas) -->
                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DeviceListPanel" Padding="10,6" Spacing="8">
                        <!-- Populated dynamically with individual solid cards -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Bar: Subtle transparent footer -->
                <Grid Grid.Row="2"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Battery Monitor" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0" />

                    <Button Grid.Column="1" Click="OnOpenSettingsClicked"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                            <TextBlock Text="设置" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
